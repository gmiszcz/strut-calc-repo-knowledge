# Copy to .env and adjust. .env is gitignored.
# AWS credentials come from the shared SSO config in ~/.aws (profile `default`,
# SSO session `tenneco-aws`). Run `aws sso login` before building or serving.

# AWS profile and region. Titan embeddings must be enabled in this region; if
# eu-central-1 lacks the model, switch to a region that has it (e.g. us-east-1)
# or use a cross-region inference profile.
AWS_PROFILE=default
AWS_REGION=eu-central-1

# Bedrock embedding model. Titan Text Embeddings V2, 1024-dim.
REPOMAP_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
REPOMAP_EMBED_DIM=1024

# Bedrock chat model for the strands-compose agent (Claude Haiku 5.5, effort low).
REPOMAP_AGENT_MODEL_ID=eu.anthropic.claude-haiku-5-5

# Local vector store (gitignored). Relative paths resolve against the repo root.
REPOMAP_DB_PATH=index.db

# MCP server bind.
REPOMAP_MCP_HOST=127.0.0.1
REPOMAP_MCP_PORT=9100

# Default number of results search_code returns.
REPOMAP_SEARCH_K=6

# Scanned repositories, JSON array of {label, root}. A relative root resolves
# against C:/WebServices. Leave empty to use the built-in default (StrutCalc).
# REPOMAP_TARGETS=[{"label":"strut-calc","root":"cae-apps/Apps/StrutCalc"}]
